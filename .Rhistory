sedata <- read_csv("A:/1 - TDM/3 - Model Dev/1 - WF/2 - Sandbox/v9.0Beta/WF TDM v9.0 - 2022-11-01/1_Inputs/2_SEData/2_WFRC/FiscallyConstrained/SE_2019.csv")
sebigboys <- sedata %>% filter(TOTHH > 24) %>%
rename("TAZID" = ";TAZID") %>%
mutate(studentRatio = TOTHH / (TOTEMP+TOTHH))
#read in TAZs
tazPolygon <- st_read("A:/1 - TDM/1 - Input Dev/1 - TAZ/1 - WF/4 - Update REMM & DISTSML/1 - Update TAZ & Districts/TAZ.shp") %>%
select(TAZID) %>%
st_set_crs(26912)
