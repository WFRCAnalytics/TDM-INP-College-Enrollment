library(sf)
library(tidyverse)
library(sf)
library(mapview)
library(kableExtra)
sedata <- read_csv("A:/1 - TDM/3 - Model Dev/1 - WF/2 - Sandbox/v9.0Beta/WF TDM v9.0 - 2022-11-01/1_Inputs/2_SEData/2_WFRC/FiscallyConstrained/SE_2019.csv")
sebigboys <- sedata %>% filter(TOTHH > 24) %>%
rename("TAZID" = ";TAZID") %>%
mutate(studentRatio = TOTHH / (TOTEMP+TOTHH))
#read in TAZs
tazPolygon <- st_read("A:/1 - TDM/1 - Input Dev/1 - TAZ/1 - WF/4 - Update REMM & DISTSML/1 - Update TAZ & Districts/TAZ.shp") %>%
select(TAZID) %>%
st_set_crs(26912)
#create TAZ centroids
tazCentroids <- tazPolygon %>%
st_centroid() %>%
st_set_crs(26912)
#create TAZs that meet SE criteria
tazPolygonSL <- tazPolygon %>%
left_join(sebigboys) %>%
select(TAZID,studentRatio) %>%
filter(TAZID %in% sebigboys$TAZID) %>%
as_tibble() %>% select(-geometry)
#read in block group quarters
blockPolygon <- st_read("intermediate/groupquarter_censusblocks_2020.shp") %>%
select(geoid20,gq_student) %>%
st_set_crs(3857) %>%
st_transform(26912)
#centroid block group quarters
blockCentroids <- blockPolygon %>%
st_centroid() %>%
st_set_crs(3857) %>%
st_transform(26912)
mapview(blockPolygon) +
mapview(blockCentroids) +
mapview(tazPolygon)
#read in block group quarters
blockPolygon <- st_read("intermediate/groupquarter_censusblocks_2020.shp") %>%
select(geoid20,gq_student) %>%
st_set_crs(3857) %>%
st_transform(26912)
#centroid block group quarters
blockCentroids <- blockPolygon %>%
st_centroid()
mapview(blockPolygon) +
mapview(blockCentroids) #+
#mapview(tazPolygon)
mapview(slCollegePolygon) +
mapview(blockCentroids)
# read in SL TAZ polygon and filter to WF area
slTazPolygon <- st_read("data/StreetLight_TAZ_2021_09_22/StreetLight_TAZ_2021_09_22.shp") %>%
filter(SUBAREAID == 1) %>%
select(SA_TAZID,SL_COTAZID) %>%
st_set_crs(26912)
# read in SL TAZ centroids
slTazCentroids <- st_read("data/StreetLight_TAZ_2021_09_22/StreetLight_TAZ_2021_09_22_centroids.shp") %>%
select(SA_TAZID,SL_COTAZID) %>%
st_set_crs(26912)
# select only those SL TAZ centroids within the SE filtered TAZ layer
slTazCentroidsHighPop <- st_read("data/StreetLight_TAZ_2021_09_22/StreetLight_TAZ_2021_09_22_centroids.shp") %>%
select(SA_TAZID,SL_COTAZID) %>%
left_join(tazPolygonSL, by = c("SA_TAZID" = "TAZID")) %>%
filter(SA_TAZID %in% tazPolygonSL$TAZID) %>%
st_set_crs(26912)
# SL polygon layer with college location
slCollegePolygon <- read_csv("data/College_to_SL_COTAZID.csv") %>%
left_join(slTazPolygon) %>%
st_as_sf()
# SL centroid layer with college location
slCollegeCentroids <- read_csv("data/College_to_SL_COTAZID.csv") %>%
left_join(slTazCentroids) %>%
st_as_sf()
mapview(slCollegePolygon) +
mapview(blockCentroids)
# filter down to main college campuses
slCollegeMainPolygon <- slCollegePolygon %>%
filter(COLLEGE %in% c("WSU_MAIN","UOFU_MAIN","UVU_MAIN","BYU", 'WESTMIN'))
# filter block groups to those near a main campus and assigned to closest campus
joinedCollegeBlocks <-  blockCentroids%>%
cbind(slCollegeMainPolygon[st_nearest_feature(blockCentroids,slCollegeMainPolygon),]) %>%
mutate(dist = st_distance(geometry,geometry.1,by_element=T)) %>%
as_tibble() %>% select(-geometry.1) %>% st_as_sf() %>%
mutate(dist = as.numeric(dist)) %>%
filter(dist < 4000)
blockCollegeCentroids <- joinedCollegeBlocks %>%
select(SA_TAZID,gq_student,COLLEGE)
mapview(slCollegeMainPolygon) +
mapview(joinedCollegeBlocks)
# join block group and taz information
blockTAZCollegeEnroll <- st_join(blockCollegeCentroids, tazPolygon, join = st_within) %>%
select(-SA_TAZID) %>%
group_by(TAZID,COLLEGE) %>%
summarize(gq_student = sum(gq_student))
# read in zip enrollment
zipEnrollment <- read_csv("intermediate/TotEnrolByZipByCollege.csv")
# read in zip polygon and filter to WF area
zipPolygon <- st_read("intermediate/ugrc_zip_codes.shp") %>%
filter(countynbr %in% c(18,2,25,6,29,20)) %>%
select(zip5) %>% mutate(zip5 = as.numeric(zip5)) %>%
st_set_crs(26912)
# join polygon and enrollment data
zipPolygonEnroll <- zipPolygon %>%
left_join(zipEnrollment, by = c("zip5" = "ZIP_Code"))
mapview(zipPolygon )
# read in zip enrollment
zipEnrollment <- read_csv("intermediate/TotEnrolByZipByCollege.csv")
# read in zip polygon and filter to WF area
zipPolygon <- st_read("intermediate/ugrc_zip_codes.shp") %>%
filter(countynbr %in% c(18,2,25,6,29,20)) %>%
select(zip5) %>% mutate(zip5 = as.numeric(zip5)) %>%
st_set_crs(26912)
# join polygon and enrollment data
zipPolygonEnroll <- zipPolygon %>%
left_join(zipEnrollment, by = c("zip5" = "ZIP_Code"))
mapview(zipPolygonEnroll)
publicControlTotals2 <- zipPolygonEnroll %>%
group_by(COLLEGE) %>%
summarize(TotEnrol = sum(TotEnrol))
# join block and zip enrollment centroids and polygons to get which blocks exist within which zip polygons.
blockZipCollegeEnroll <- st_join(blockCollegeCentroids, zipPolygon, join = st_within) %>%
as_tibble() %>% select(-geometry) %>%
mutate(GQEnrol = gq_student, zip5 = as.numeric(zip5)) %>%
select(zip5,COLLEGE,GQEnrol) %>%
group_by(zip5,COLLEGE) %>%
summarize(GQEnrol = sum(GQEnrol))
# test a bunch of stuff to double check work
#test <- blockZipCollegeEnroll %>% filter(!(COLLEGE %in% c("BYU","WESTMIN")))
#test2 <- zipPolygonEnroll %>% filter(!is.na(TotEnrol)) %>% as_tibble()
#test3 <- zipMinusBlock %>% filter(!(is.na(TotMinGQ))) %>% as_tibble()
#sum(test[,'GQEnrol'])
#sum(test2[,'TotEnrol'])
#sum(test3[,'TotMinGQ'])
# subtract group quarter/block level data from each zip code by school
# negative enrollment locations are replaced with NA
zipMinusBlock <- zipPolygonEnroll %>%
group_by(zip5,COLLEGE) %>%
summarize(TotEnrol = sum(TotEnrol)) %>%
ungroup() %>%
left_join(blockZipCollegeEnroll, by = c("zip5","COLLEGE")) %>%
mutate(GQEnrol = ifelse(is.na(GQEnrol), 0, GQEnrol)) %>%
mutate(TotMinGQ = TotEnrol - GQEnrol) %>%
mutate(TotMinGQ = ifelse(TotMinGQ < 0, NA, TotMinGQ)) %>%
filter(!is.na(TotMinGQ))
# clean up the new zip level dataset
zipMinusBlockShort <- zipMinusBlock %>%
select(zip5,COLLEGE,TotMinGQ) %>%
group_by(zip5,COLLEGE) %>%
summarize(TotMinGQ = sum(TotMinGQ)) %>%
as_tibble() %>% select(-geometry)
# read in college SL key
slCollegeKey <- read_csv("data/College_to_SL_COTAZID.csv") %>%
filter(COLLEGE != "UVU_GENEVA")
# filter SL trips and determine college trips
slTrips <- read_csv("intermediate/dfCollegeDataOD.csv") %>%
filter(day_type == "1: Weekday (Tu-Th)", day_part == "3: Mid-Day (9am-3pm)") %>%
left_join(slCollegeKey, by = c("origin_zone_name" = "SL_COTAZID")) %>%
mutate(O_COLLEGE = COLLEGE) %>% select(-COLLEGE) %>%
left_join(slCollegeKey, by = c("destination_zone_name" = "SL_COTAZID")) %>%
mutate(D_COLLEGE = COLLEGE) %>% select(-COLLEGE)
# summarize college trips, filter down to only those areas of SE interest, and multiple trips by the student ratio
# filter dataset to only college trips
slTripTotals <- slTrips %>%
group_by(origin_zone_name, D_COLLEGE) %>%
summarize(sum = sum(o_d_traffic_calibrated_trip_volume)) %>%
left_join(slTazCentroidsHighPop, by = c("origin_zone_name" = "SL_COTAZID")) %>%
# if we want to use student ratio
mutate(sum = sum * studentRatio) %>%
select(-studentRatio) %>%
ungroup() %>%
st_as_sf() %>%
filter(!(is.na(D_COLLEGE))) %>%
filter(!(is.na(SA_TAZID)))
publicSLTrips <- slTripTotals %>%
filter(!(D_COLLEGE %in% c("BYU", "WESTMIN", "ENSIGN")))
privateSLTrips <- slTripTotals %>%
filter((D_COLLEGE %in% c("BYU", "WESTMIN", "ENSIGN")))
# determine which zip code each sl trip is in
publicSLTripZip0 <- st_join(publicSLTrips, zipPolygon, join = st_within) %>%
mutate(COLLEGE = D_COLLEGE) %>% select(-D_COLLEGE) %>%
merge(zipMinusBlockShort, by = c("zip5", "COLLEGE"), all=T) %>%
group_by(zip5) %>%
## fill in SL trips where ZIP enrollment exists but SL data does not (there are still about 47 trips we lose with this process, but we pick up most of them)
fill(c(origin_zone_name,SA_TAZID), .direction ="downup") %>%
mutate(sum = ifelse(is.na(sum), 0.7435897, sum))
# clean the new zip/sl trip dataset
publicSLTripZip <- publicSLTripZip0 %>%
filter(!(is.na(TotMinGQ))) %>% filter(!(is.na(origin_zone_name))) %>%
as_tibble() %>% select(-geometry)
# this is for debugging
publicLostZipTrips <- publicSLTripZip0 %>%
filter((!(is.na(TotMinGQ))) & (is.na(origin_zone_name))) %>%
group_by(COLLEGE) %>% summarize(TotLost = sum(TotMinGQ)) %>%
as_tibble() %>% select(-geometry)
# get total number of sl trips occurring in each zip code
publicSLTotalZip <- publicSLTripZip %>%
group_by(zip5,COLLEGE) %>%
summarize(SlZipTrips = sum(sum))
# get total number of sl trips occurring in each sl zone
# get percentage of sl trips of each sl zone by total in each zip code
publicDistribByZip<- publicSLTripZip %>%
group_by(zip5, origin_zone_name, COLLEGE, TotMinGQ) %>%
summarize(SLTrips = sum(sum)) %>%
left_join(publicSLTotalZip) %>%
mutate(PerSL = SLTrips / SlZipTrips) %>%
mutate(TotMinGQ_SL = PerSL * TotMinGQ) %>%
select(zip5,COLLEGE,origin_zone_name,TotMinGQ_SL) %>%
as_tibble()
doubleCheck1 <- publicDistribByZip %>%
group_by(zip5,COLLEGE) %>%
summarize(TotMinGQ = sum(TotMinGQ_SL))
View(doubleCheck1)
doubleCheck1 <- publicDistribByZip %>%
group_by(zip5,COLLEGE) %>%
summarize(TotMinGQ = sum(TotMinGQ_SL))
# select the block group quarter college enrollment by tazs
tazWBlockPublic <- blockTAZCollegeEnroll %>%
filter(!(COLLEGE %in% c("BYU", "WESTMIN")))
# filter all the taz's with gq numbers that don't exist in the SL dataset, to be added on -- we don't want to forget about them!
tazWBlockPublicExtra <- tazWBlockPublic %>%
filter(!(TAZID %in% publicSLTripZip$SA_TAZID)) %>%
rename("SA_TAZID" = "TAZID", "COLLEGE" = "COLLEGE", "TAZTot" = "gq_student") %>%
as_tibble() %>% select(-geometry)
# ------ THIS IS WHERE THE MAGIC HAPPENS ------ #
# summarize the SL/zip college enrollment dataset by the TAZ level
# join on the block group level TAZ data and add those totals to the zip/SL totals
# join on the missing gq data as well
# join on the polygon to be able to view it
publicTazDistrib <- publicDistribByZip %>%
left_join(publicSLTripZip) %>% select(-sum) %>%
group_by(SA_TAZID,COLLEGE) %>%
summarize(TAZTotMinGQ = sum(TotMinGQ_SL)) %>%
left_join(blockTAZCollegeEnroll, by = c("SA_TAZID" = "TAZID", "COLLEGE" = "COLLEGE")) %>%
as_tibble() %>% select(-geometry) %>%
mutate(gq_student = ifelse(is.na(gq_student),0,gq_student)) %>%
mutate(TAZTot = TAZTotMinGQ + gq_student) %>%
select(-TAZTotMinGQ,-gq_student) %>%
bind_rows(tazWBlockPublicExtra) %>%
left_join(tazPolygon, by = c("SA_TAZID" = "TAZID")) %>%
st_as_sf()
doubleCheck1.2 <- publicTazDistrib %>%
group_by(COLLEGE) %>%
summarize(TotEnrol = sum(TAZTot)) %>%
left_join(publicLostZipTrips)
# WSU_MAIN is a little too high, and UOFU_MAIN is also high. Is is due to the combination of being unable to subtract total GQ amounts by zipcode as well filtering out a subset of data where zipcode enrollment existed but no streetlight data existed
View(doubleCheck1.2)
WSU_MAIN <- publicTazDistrib %>% filter(COLLEGE == "WSU_MAIN") %>%select(SA_TAZID,TAZTot)
WSU_DAVIS <- publicTazDistrib %>% filter(COLLEGE == "WSU_DAVIS") %>%select(SA_TAZID,TAZTot)
UOFU_MAIN <- publicTazDistrib %>% filter(COLLEGE == "UOFU_MAIN") %>%select(SA_TAZID,TAZTot)
SLCC_SC <- publicTazDistrib %>% filter(COLLEGE == "SLCC_SC") %>%select(SA_TAZID,TAZTot)
SLCC_MAIN <- publicTazDistrib %>% filter(COLLEGE == "SLCC_MAIN") %>%select(SA_TAZID,TAZTot)
SLCC_JD <- publicTazDistrib %>% filter(COLLEGE == "SLCC_JD") %>%select(SA_TAZID,TAZTot)
SLCC_ML <- publicTazDistrib %>% filter(COLLEGE == "SLCC_ML") %>%select(SA_TAZID,TAZTot)
UVU_MAIN <- publicTazDistrib %>% filter(COLLEGE == "UVU_MAIN") %>%select(SA_TAZID,TAZTot)
WSU_MAIN <- publicTazDistrib %>% filter(COLLEGE == "WSU_MAIN") %>%select(SA_TAZID,TAZTot)
mapview(WSU_MAIN, zcol = "TAZTot") +
mapview(WSU_DAVIS, zcol = "TAZTot") +
mapview(UOFU_MAIN, zcol = "TAZTot") +
mapview(SLCC_SC, zcol = "TAZTot") +
mapview(SLCC_MAIN, zcol = "TAZTot") +
mapview(SLCC_JD, zcol = "TAZTot") +
mapview(SLCC_ML, zcol = "TAZTot") +
mapview(UVU_MAIN, zcol = "TAZTot") +
mapview(WSU_MAIN, zcol = "TAZTot")
# add a control total column to the private college sl trip dataset
privateSLTrip <- privateSLTrips %>%
mutate(TotMinGQ = ifelse(D_COLLEGE == "BYU", (34300 - 10055),
ifelse(D_COLLEGE == "WESTMIN", (2200 - 565),
1950)))
# calculate the total number of sl trips that occur for each private college
privateSLTotal <- privateSLTrip %>%
group_by(D_COLLEGE) %>%
summarize(AllTrips = sum(sum)) %>%
as_tibble() %>% select(-geometry)
# using the total number of sl trips, calculate the percent occuring in each sl zone
# also calculate number of students within each zone using the control total minus gq data
privateDistribByAll <- privateSLTrip %>%
group_by(origin_zone_name,D_COLLEGE,TotMinGQ) %>%
summarize(SLTrips = sum(sum)) %>%
left_join(privateSLTotal) %>%
mutate(PerSL = SLTrips / AllTrips) %>%
mutate(TotMinGQ_SL = PerSL * TotMinGQ) %>%
select(D_COLLEGE,origin_zone_name,TotMinGQ_SL) %>%
as_tibble()
doubleCheck2 <- privateDistribByAll %>%
group_by(D_COLLEGE) %>%
summarize(TotMinGQ = sum(TotMinGQ_SL))
View(doubleCheck2)
doublecheck2.2 <- privateTazDistrib %>%
group_by(COLLEGE) %>%
summarize(TAZTot = sum(TAZTot))
# get private school block taz enrollment totals
tazWBlockPrivate <- blockTAZCollegeEnroll %>%
filter(COLLEGE %in% c("BYU", "WESTMIN"))
# summarize the data to be easily added onto the final taz distribution
tazWBlockPrivateExtra <- tazWBlockPrivate %>%
filter(!(TAZID %in% privateSLTrip$SA_TAZID)) %>%
rename("SA_TAZID" = "TAZID", "D_COLLEGE" = "COLLEGE", "TAZTot" = "gq_student") %>%
as_tibble() %>% select(-geometry)
# calculate the total number of enorllment by taz for the private schools
# add back in the gq totals
# clean up the datset
privateTazDistrib <- privateDistribByAll %>%
left_join(privateSLTrip) %>% select(-sum) %>%
group_by(SA_TAZID,D_COLLEGE) %>%
summarize(TAZTotMinGQ = sum(TotMinGQ_SL)) %>%
left_join(tazWBlockPrivate, by = c("SA_TAZID" = "TAZID", "D_COLLEGE" = "COLLEGE")) %>%
as_tibble() %>% select(-geometry) %>%
mutate(gq_student = ifelse(is.na(gq_student),0,gq_student)) %>%
mutate(TAZTot = TAZTotMinGQ + gq_student) %>%
select(-TAZTotMinGQ,-gq_student) %>%
rbind(tazWBlockPrivateExtra) %>%
left_join(tazPolygon, by = c("SA_TAZID" = "TAZID")) %>%
rename("COLLEGE" = "D_COLLEGE") %>%
st_as_sf()
doublecheck2.2 <- privateTazDistrib %>%
group_by(COLLEGE) %>%
summarize(TAZTot = sum(TAZTot))
View(doublecheck2.2)
P_BYU <- privateTazDistrib %>% filter(COLLEGE == "BYU") %>%select(SA_TAZID,TAZTot)
P_ENSIGN <- privateTazDistrib %>% filter(COLLEGE == "ENSIGN") %>%select(SA_TAZID,TAZTot)
P_WESTMIN <- privateTazDistrib %>% filter(COLLEGE == "WESTMIN") %>%select(SA_TAZID,TAZTot)
mapview(P_BYU, zcol = "TAZTot") +
mapview(P_ENSIGN, zcol = "TAZTot") +
mapview(P_WESTMIN, zcol = "TAZTot")
# merge public and private infor
# fill in all missing tazs with 0
tazDistrib <- bind_rows(publicTazDistrib,privateTazDistrib) %>%
as_tibble() %>% select(-geometry) %>%
complete(SA_TAZID = min(1):max(3547),COLLEGE) %>%
mutate(TAZTot = ifelse(is.na(TAZTot),0,TAZTot)) %>%
filter(!(is.na(COLLEGE)))
# round the data
tazDistribRounded <- tazDistrib %>%
mutate(TAZTot = as.numeric(round(TAZTot,0))) %>%
group_by(COLLEGE)
# put data in desired format and export a csv file!
finalRounded <- tazDistribRounded %>%
pivot_wider(names_from = "COLLEGE", values_from = "TAZTot") %>%
rename(";Z" = "SA_TAZID")
pedant:::add_double_colons()
library(tidyverse)
library(sf)
library(mapview)
library(kableExtra)
pedant:::add_double_colons()
